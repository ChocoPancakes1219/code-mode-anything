{
  "name": "code-mode-anything",
  "version": "0.1.0",
  "description": "Generate installable code-mode harnesses for MCP servers, APIs, and software.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cma": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "catalog.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "format:check": "prettier --check src tests scripts skills examples README.md package.json tsconfig.json catalog.json"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1",
    "commander": "^13.1.0",
    "jsonc-parser": "^3.3.1",
    "mcp-remote": "0.15.2",
    "quickjs-emscripten": "0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
